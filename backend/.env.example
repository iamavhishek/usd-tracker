# ─── Server ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated browser origins, or * for any (mobile apps ignore CORS).
CORS_ORIGINS=*
# IANA zone used by the cron scheduler (polling is every minute regardless).

# ─── Rate tracking ─────────────────────────────────────────────────────────
BASE_CURRENCY=USD
# Comma-separated ISO-4217 codes. Each quote is polled every minute.
TRACKED_QUOTES=NPR
# Standard 5-field cron. "* * * * *" = every minute.
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2
FRANKFURTER_TIMEOUT_MS=10000
FRANKFURTER_RETRIES=2

# ─── Database (Turso Cloud / libSQL) ──────────────────────────────────────
# Local default: a libSQL file. For Turso Cloud use libsql://<db>-<org>.turso.io
# with TURSO_AUTH_TOKEN from `turso db tokens create <db>`.
TURSO_DATABASE_URL=file:./data/usd-tracker.db
TURSO_AUTH_TOKEN=
DATABASE_AUTO_MIGRATE=true
MIGRATIONS_DIR=./drizzle
HISTORY_RETENTION_DAYS=7
NOTIFICATION_RETENTION_DAYS=7

# ─── API security ──────────────────────────────────────────────────────────
# Empty = mutating endpoints are public (local development only).
# Generate one with: openssl rand -hex 32
API_KEY=

# ─── Notifications ─────────────────────────────────────────────────────────
# false = push only on threshold crossings / significant moves (recommended).
# true  = push the rate to every device on every poll (once per minute).
NOTIFY_EVERY_TICK=false
# Push when the rate moves at least this % vs the previous reading. 0 disables.
SIGNIFICANT_CHANGE_PERCENT=0.5
# Default minimum gap between two pushes for the same alert rule.
ALERT_COOLDOWN_SECONDS=21600
FCM_ANDROID_CHANNEL_ID=usd_rates
FCM_ANDROID_ICON=ic_stat_usd
# Optional web-push icon; must be an absolute URL.
FCM_WEB_ICON=

# ─── Firebase service account (provide ONE of these) ───────────────────────
# 1) Path to the JSON key downloaded from Firebase console → Project settings.
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# 2) The full JSON on one line (handy for container secrets).
FIREBASE_SERVICE_ACCOUNT_JSON=
# 3) Base64 of the JSON: base64 -i service-account.json | tr -d '\n'
FIREBASE_SERVICE_ACCOUNT_BASE64=
# 4) Or point the Google SDK at a file.
GOOGLE_APPLICATION_CREDENTIALS=

# Secret sent by the external cron service to /api/v1/cron/*.
CRON_SECRET=change-me-to-a-long-random-value
